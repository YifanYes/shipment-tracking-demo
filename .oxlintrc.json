{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "jsx-a11y"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "no-debugger": "error",
    "react/react-in-jsx-scope": "off"
  },
  "ignorePatterns": ["dist/**", "coverage/**", "node_modules/**", ".husky/_/**"]
}
